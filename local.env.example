# Copy to local.env (not tracked) and fill in.
GLINER_PYTHON=/path/to/venv_with_gliner/bin/python        # pip install -r Report-Extractor/requirements.txt
LINK_PYTHON=/path/to/venv_of_the_linker/bin/python
PYTHONPATH=/path/to/linker_package                        # folder containing the linking package
LINKER_MODULE=package.link                                # module exposing Linker
ENCODER=bioelx-nlp/bioelx_retriever                       # retriever (Hugging Face id)
INDEX=/path/to/index_dir                                  # catalogue encoded by ENCODER: index.faiss, cuis.json, DONE
CHECKPOINT=/path/to/reranker.pt
GRAPH=/path/to/umls_graph.pkl
MRCONSO=/path/to/UMLS/MRCONSO.RRF                         # preferred English names (optional for linking)
HF_HUB_OFFLINE=0
